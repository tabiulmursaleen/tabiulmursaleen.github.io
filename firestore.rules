rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'wWuBEmlsaofgjAaQi7bfblsX6L62';
    }

    function isAnonymousUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function teacherSessionPath(uid) {
      return /databases/$(database)/documents/teacherSessions/$(uid);
    }

    function hasTeacherSession() {
      return isAnonymousUser()
        && exists(teacherSessionPath(request.auth.uid));
    }

    function currentTeacherId() {
      return get(teacherSessionPath(request.auth.uid)).data.teacherId;
    }

    function matchesPrivateTeacherDob(teacherId, dob) {
      return exists(/databases/$(database)/documents/directoryPrivate/$(teacherId))
        && get(/databases/$(database)/documents/directoryPrivate/$(teacherId)).data.dob == dob;
    }

    // Published notices are public; all notice management requires the admin.
    match /notices/{noticeId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Published committee, teacher, and staff profiles are public. Only admins manage them.
    match /directoryPeople/{personId} {
      allow read: if isAdmin()
        || (resource.data.published == true && !('dob' in resource.data));
      allow create, update, delete: if isAdmin();
    }

    // Public teacher login list; contains profile fields only and never includes DOB.
    match /publicTeacherDirectory/{teacherId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Dates of birth are private and only accessible to administrators.
    match /directoryPrivate/{personId} {
      allow read, create, update, delete: if isAdmin();
    }

    // A teacher's anonymous session is created only when the submitted DOB matches
    // the administrator-only directoryPrivate record for that teacher.
    match /teacherSessions/{uid} {
      allow read: if isAdmin() || (isAnonymousUser() && request.auth.uid == uid);
      allow create: if isAnonymousUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['teacherId', 'dob'])
        && request.resource.data.keys().hasOnly(['teacherId', 'dob'])
        && request.resource.data.teacherId is string
        && request.resource.data.dob is string
        && matchesPrivateTeacherDob(request.resource.data.teacherId, request.resource.data.dob);
      allow update: if false;
      allow delete: if isAdmin() || (isAnonymousUser() && request.auth.uid == uid);
    }

    // Class learning resources are public only after publication.
    match /classContents/{contentId} {
      allow read: if isAdmin() || resource.data.published == true
        || (hasTeacherSession() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() || (hasTeacherSession()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.authorTeacherId == currentTeacherId());
      allow update: if isAdmin() || (hasTeacherSession()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.authorTeacherId == currentTeacherId()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.authorTeacherId == resource.data.authorTeacherId
        && request.resource.data.authorName == resource.data.authorName);
      allow delete: if isAdmin() || (hasTeacherSession()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.authorTeacherId == currentTeacherId());
    }

    // Gallery media metadata and public links are readable after publication.
    match /galleryItems/{itemId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Class routines contain public timetable data; only admins can change them.
    match /classRoutines/{branchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Exam schedules are public only after the admin publishes them.
    match /examRoutines/{routineId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Student personal and guardian information stays admin-only.
    match /students/{studentCode} {
      allow read, create, update, delete: if isAdmin();
    }

    // Only the deliberately limited, published directory record is public.
    match /studentDirectory/{directoryId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Payment records and the full gradebook are private to the admin.
    match /studentFees/{feeId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Institutional expense records are private to the admin.
    match /institutionExpenses/{expenseId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /studentResults/{resultId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Teachers can access only drafts under their DOB-validated anonymous session; admins can access all drafts.
    match /questionPapers/{paperId} {
      allow read: if isAdmin() || (hasTeacherSession()
        && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() || (hasTeacherSession()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.authorTeacherId == currentTeacherId());
      allow update: if isAdmin() || (hasTeacherSession()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorTeacherId == resource.data.authorTeacherId
        && resource.data.authorTeacherId == currentTeacherId());
      allow delete: if isAdmin() || (hasTeacherSession()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.authorTeacherId == currentTeacherId());
    }

    // Per-student in-progress marks are private and can only be managed by the admin.
    match /studentResultDrafts/{resultId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Teacher-entered result drafts are isolated by authenticated teacher session.
    match /teacherResultDrafts/{resultId} {
      allow read: if isAdmin() || (hasTeacherSession()
        && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() || (hasTeacherSession()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.authorTeacherId == currentTeacherId());
      allow update: if isAdmin() || (hasTeacherSession()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.authorTeacherId == currentTeacherId()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.authorTeacherId == resource.data.authorTeacherId
        && request.resource.data.authorName == resource.data.authorName);
      allow delete: if isAdmin() || (hasTeacherSession()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.authorTeacherId == currentTeacherId());
    }

    // A result becomes public only when the admin marks it published.
    match /publicStudentResults/{resultId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Deny access to every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
