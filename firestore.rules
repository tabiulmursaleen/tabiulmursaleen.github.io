rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'wWuBEmlsaofgjAaQi7bfblsX6L62';
    }

    // Published notices are public; all notice management requires the admin.
    match /notices/{noticeId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Published committee, teacher, and staff profiles are public. Only admins manage them.
    match /directoryPeople/{personId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Class learning resources are public only after publication.
    match /classContents/{contentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Gallery media metadata and public links are readable after publication.
    match /galleryItems/{itemId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Class routines contain public timetable data; only admins can change them.
    match /classRoutines/{branchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Exam schedules are public only after the admin publishes them.
    match /examRoutines/{routineId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Student personal and guardian information stays admin-only.
    match /students/{studentCode} {
      allow read, create, update, delete: if isAdmin();
    }

    // Only the deliberately limited, published directory record is public.
    match /studentDirectory/{directoryId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Payment records and the full gradebook are private to the admin.
    match /studentFees/{feeId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Institutional expense records are private to the admin.
    match /institutionExpenses/{expenseId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /studentResults/{resultId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Question papers are private drafts managed and printed by the admin.
    match /questionPapers/{paperId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Per-student in-progress marks are private and can only be managed by the admin.
    match /studentResultDrafts/{resultId} {
      allow read, create, update, delete: if isAdmin();
    }

    // A result becomes public only when the admin marks it published.
    match /publicStudentResults/{resultId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Deny access to every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
